#!/bin/sh

set -u

if [ "${CODEX_SKIP_COMMIT_REVIEW:-}" = "1" ]; then
  echo "Codex commit review skipped because CODEX_SKIP_COMMIT_REVIEW=1."
  exit 0
fi

if ! command -v codex >/dev/null 2>&1; then
  echo "Codex commit review skipped: codex command was not found on PATH."
  exit 0
fi

commit_sha="$(git rev-parse --verify HEAD 2>/dev/null)" || exit 0
commit_title="$(git log -1 --pretty=%s "$commit_sha" 2>/dev/null || true)"

echo
echo "Running Codex review for commit $commit_sha..."

codex review --commit "$commit_sha" --title "$commit_title" \
  "Review this commit for correctness bugs, regressions, security issues, and missing tests. Focus on actionable findings with file and line references."
status=$?

if [ "$status" -ne 0 ]; then
  echo "Codex commit review failed with exit code $status."
  echo "The commit was already created. Re-run manually with: codex review --commit $commit_sha"
fi

exit 0
