#!/bin/sh
# Post-commit Codex review. Headless review must use the non-interactive
# runner (`codex exec review`), not the interactive `codex review` TUI
# subcommand; the commit preset takes --commit/--title only and does NOT
# accept a positional custom prompt (that combination is a CLI arg error).
# Skip with CODEX_SKIP_COMMIT_REVIEW=1.

set -u

if [ "${CODEX_SKIP_COMMIT_REVIEW:-}" = "1" ]; then
  echo "Codex commit review skipped because CODEX_SKIP_COMMIT_REVIEW=1."
  exit 0
fi

if ! command -v codex >/dev/null 2>&1; then
  echo "Codex commit review skipped: codex command was not found on PATH."
  exit 0
fi

commit_sha="$(git rev-parse --verify HEAD 2>/dev/null)" || exit 0
commit_title="$(git log -1 --pretty=%s "$commit_sha" 2>/dev/null || true)"

echo
echo "Running Codex review for commit $commit_sha..."

codex exec --sandbox read-only review --commit "$commit_sha" --title "$commit_title"
status=$?

if [ "$status" -ne 0 ]; then
  echo "Codex commit review failed with exit code $status."
  echo "The commit was already created. Re-run manually with:"
  echo "  codex exec --sandbox read-only review --commit $commit_sha"
fi

exit 0
