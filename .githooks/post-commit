#!/bin/sh
# Post-commit: automated agent handoff (ADR 0004). Evaluates the task board
# and dispatches the agent with actionable work. Never blocks or fails the
# commit.
#
# The former per-commit Codex review (T-033) was removed 2026-07-10: ADR 0004
# gives every task an independent @claude review before Done, making the
# per-commit pass redundant — and it ran in the foreground, blocking the
# terminal and anything queued behind the commit. Re-run one manually with:
#   codex exec --sandbox read-only review --commit <sha>

set -u

if [ -x "$(git rev-parse --show-toplevel)/scripts/agent_handoff.sh" ]; then
  sh "$(git rev-parse --show-toplevel)/scripts/agent_handoff.sh" || true
fi

# Refresh the GitNexus knowledge graph in the background (never blocks).
"$(git rev-parse --git-path hooks)/gitnexus-refresh" || true

exit 0
