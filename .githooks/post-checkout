#!/bin/sh
# Post-checkout: refresh the GitNexus knowledge graph after a branch checkout
# (the working tree — and thus the graph — changed). Never blocks the checkout.
#
# Args: $1 = previous HEAD, $2 = new HEAD, $3 = 1 for a branch checkout, 0 for a
# file checkout (e.g. `git checkout -- path`, which must NOT trigger a re-index).

set -u

[ "${3:-0}" = "1" ] || exit 0     # ignore file checkouts
[ "${1:-}" != "${2:-}" ] || exit 0  # no-op when HEAD didn't actually move

"$(git rev-parse --git-path hooks)/gitnexus-refresh" || true

exit 0
