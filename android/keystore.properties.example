# Example keystore.properties for Android release signing
# Copy this file to `android/keystore.properties` (or repository root `keystore.properties`)
# Fill in your production Android Keystore details. NEVER commit keystore.properties or .jks files to git.

storeFile=/path/to/paisatrack-release-key.jks
storePassword=your_keystore_password
keyAlias=paisatrack_release_alias
keyPassword=your_key_password
